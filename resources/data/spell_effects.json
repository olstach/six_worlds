{
  "_comment": "The vocabulary a spell's `special` block may use. Every entry in a spell's `special.effects` array is {\"type\": <one of these>, ...params}. This file is the contract: validate_data.py rejects a type that is not here and a required param that is missing, so a new effect is declared once and then used, rather than invented per spell. That is what went wrong before — `special` was a free dict, 369 distinct keys accumulated across 210 spells, 88% of them used exactly once, and CombatManager branched on three.",
  "_comment_implemented": "`implemented` says whether CombatManager._apply_spell_special actually acts on the type yet. False means the effect is declared and validated but inert — honest, and visible in tools/audit_spells.py, rather than silently doing nothing.",
  "effects": {
    "apply_status": {
      "description": "Apply a status to the target, optionally on a chance or a failed save.",
      "params": {
        "status": "status name, required",
        "chance": "0-100, default 100",
        "duration": "turns or 'spellpower', optional",
        "to": "target|caster|allies|enemies, default target",
        "on_failed_save": "attribute name, optional"
      },
      "implemented": false
    },
    "remove_status": {
      "description": "Strip statuses by name, category word or dispel method.",
      "params": {
        "statuses": "array of names/categories/methods, required",
        "to": "target|caster|allies, default target",
        "limit": "max removed, optional"
      },
      "implemented": false
    },
    "push": {
      "description": "Move the target away from a point.",
      "params": {
        "distance": "tiles, required",
        "direction": "away_from_caster|toward_caster, default away_from_caster",
        "min_distance": "optional",
        "max_distance": "optional"
      },
      "implemented": false
    },
    "teleport": {
      "description": "Move a unit to another tile.",
      "params": {
        "who": "self|target|party, required",
        "destination": "chosen|behind_target|adjacent_target|safety|last_healing_location, required — last_healing_location is an overworld destination (the last teahouse, temple or town visited) rather than a tile",
        "range": "tiles, optional"
      },
      "implemented": false
    },
    "heal": {
      "description": "Restore HP.",
      "params": {
        "amount": "flat, or 'pct_of_damage_dealt', required",
        "to": "target|caster|allies|all_allies, default target",
        "per_turn": "true for a heal-over-time, default false"
      },
      "implemented": false
    },
    "stat_bonus": {
      "description": "Temporary modifier to a derived stat or attribute.",
      "params": {
        "stat": "stat or attribute key, required",
        "amount": "number, required",
        "is_percent": "default false",
        "to": "target|caster|allies, default caster",
        "duration": "turns, optional"
      },
      "implemented": false
    },
    "resistance": {
      "description": "Temporary resistance change.",
      "params": {
        "element": "element or damage type, or 'all', required",
        "pct": "number, required",
        "to": "target|caster|allies, default caster",
        "duration": "turns, optional"
      },
      "implemented": false
    },
    "immunity": {
      "description": "Blanket immunity for a duration.",
      "params": {
        "to": "melee|ranged|physical|mental|ground_effects|all_damage, required",
        "duration": "turns, optional"
      },
      "implemented": false
    },
    "bonus_damage_vs": {
      "description": "Extra damage against a tagged kind of creature.",
      "params": {
        "tag": "undead|living|spirit|demon|..., required",
        "pct": "percentage bonus — give this or `amount`",
        "amount": "flat bonus damage, use instead of pct when the data gives a number of points"
      },
      "implemented": false
    },
    "reflect": {
      "description": "Return damage or spells to the attacker.",
      "params": {
        "what": "spell|physical, required",
        "chance": "0-100, default 100",
        "pct": "fraction returned, required"
      },
      "implemented": false
    },
    "lifesteal": {
      "description": "Heal the caster for a fraction of damage dealt.",
      "params": {
        "pct": "number, required"
      },
      "implemented": false
    },
    "aura": {
      "description": "A radius around the caster that applies something each turn.",
      "params": {
        "radius": "tiles, required",
        "effects": "array of nested effect entries, required",
        "affects": "allies|enemies|all, default allies"
      },
      "implemented": false
    },
    "ground_effect": {
      "description": "Leave a cloud or terrain patch behind.",
      "params": {
        "effect": "named terrain/cloud, required",
        "radius": "tiles, optional",
        "duration": "turns, optional",
        "on_enter": "nested effect entries, optional"
      },
      "implemented": false
    },
    "summon_extra": {
      "description": "Summon beyond the spell's own `summon` field.",
      "params": {
        "template": "summon template id, required",
        "count": "default 1",
        "per_turn": "default false",
        "hp": "override the summoned creature's HP, optional"
      },
      "implemented": false
    },
    "caster_ai": {
      "description": "What a summoned creature casts. Descriptive; read by summon AI, not combat.",
      "params": {
        "schools": "array of school names, required"
      },
      "implemented": false
    },
    "prevent": {
      "description": "Deny an action or outcome for a duration.",
      "params": {
        "what": "fleeing|teleport|resurrection|raising_as_undead|phasing, required",
        "duration": "turns, optional"
      },
      "implemented": false
    },
    "illusion": {
      "description": "Create decoy copies of a unit.",
      "params": {
        "count": "required",
        "hp": "per copy, optional",
        "absorbs_attacks": "default true"
      },
      "implemented": false
    },
    "reward": {
      "description": "Grant a resource on a trigger.",
      "params": {
        "resource": "gold|xp, required",
        "amount": "number or 'scales_with_spellpower'",
        "on": "kill|cast|break, required"
      },
      "implemented": false
    },
    "scaling": {
      "description": "Declare what a number scales with, where the spell's own fields cannot say it.",
      "params": {
        "field": "which field scales, required",
        "with": "spellpower|mana_spent|debuffs_on_target|..., required"
      },
      "implemented": false
    },
    "chain": {
      "description": "Jump to further targets after the first.",
      "params": {
        "count": "additional targets, required",
        "range": "tiles between jumps, optional",
        "damage_pct": "fraction carried to each jump, default 100"
      },
      "implemented": false
    },
    "note": {
      "description": "Non-mechanical annotation. Never read by combat; keeps design intent next to the spell.",
      "params": {
        "text": "required"
      },
      "implemented": true
    },
    "visual": {
      "description": "Presentation hint for the effect layer.",
      "params": {
        "text": "required"
      },
      "implemented": true
    },
    "dispel_battlefield": {
      "description": "Clear every persistent battlefield effect.",
      "params": {},
      "implemented": true
    },
    "see_through_stealth": {
      "description": "Reveal hidden units for a duration.",
      "params": {
        "duration": "turns, optional"
      },
      "implemented": true
    },
    "stealth_bonus": {
      "description": "Modify how hard the target is to see.",
      "params": {
        "amount": "number, required",
        "duration": "turns, optional"
      },
      "implemented": true
    },
    "range_modifier": {
      "description": "Change the range of the target's attacks or spells.",
      "params": {
        "pct": "percentage change, optional",
        "amount": "flat tiles, optional",
        "applies_to": "ranged_attacks|spells|both, default both"
      },
      "implemented": false
    }
  },
